{
  "expo": {
    "name": "Aura",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/aura-icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.za.aura.fintech",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#06261E",
        "foregroundImage": "./assets/images/aura-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "co.za.aura.fintech"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/aura-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/aura-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#06261E"
        }
      ],
      "@clerk/expo"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7c927663-15db-4848-be11-3cf954b88cf7"
      }
    }
  }
}
