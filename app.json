{
  "expo": {
    "name": "Aura",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/aura-icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#06261E",
        "foregroundImage": "./assets/images/aura-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/aura-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/aura-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#06261E"
        }
      ],
      "@clerk/expo"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
